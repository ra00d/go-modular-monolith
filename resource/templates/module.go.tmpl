package {{ .ModuleName }}

import (
	"{{ .GoModule }}/{{ .ModulePath }}/api/rest"
	"{{ .GoModule }}/{{ .ModulePath }}/app"
	"{{ .GoModule }}/internal/modules"
	"{{ .GoModule }}/lib/db"

	"github.com/jmoiron/sqlx"
	"go.uber.org/fx"

	"{{ .GoModule }}/{{ .ModulePath }}/migrations"
)

var Module = fx.Module("{{ .ModuleName }}",
	fx.Provide(func(DB *sqlx.DB) *app.Application {
		app := app.Application{}
		return &app
	}),

	fx.Invoke(rest.RegisterRoutes),
	fx.Invoke(db.MigrateAndGenerateTypes(migrations.Migrations)),
)

func init() {
	modules.Register(Module, "{{ .ModuleTitle }}")
}
