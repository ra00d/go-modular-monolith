package {{ .ModuleName }}

import (
	"{{ .GoModule }}/internal/{{ .ModuleName }}/api/rest"
	"{{ .GoModule }}/internal/{{ .ModuleName }}/app"
	"{{ .GoModule }}/lib/db"

	"github.com/jmoiron/sqlx"
	"go.uber.org/fx"

	"{{ .ModuleName }}/internal/{{ .ModuleName }}/migrations"
)

var Module = fx.Module("{{ .ModuleName }}",
	fx.Provide(func(DB *sqlx.DB) *app.Application {
		app := app.Application{}
		return &app
	}),

	fx.Invoke(rest.RegisterRoutes),
	fx.Invoke(db.MigrateAndGenerateTypes(migrations.Migrations)),
)

func init(){

  }
